# Base URL of the real LAUPAY backend (NestJS). Required once VITE_USE_MOCK_API=false.
VITE_API_BASE_URL=https://laupay.onrender.com/api

# "true" (default for local/isolated dev) uses the in-memory mock adapter in
# src/services/mock.ts — no network calls, no real backend needed.
# "false" switches every service call to the real adapter in
# src/services/{auth,wallet,orders}.ts, which hits VITE_API_BASE_URL.
VITE_USE_MOCK_API=false
