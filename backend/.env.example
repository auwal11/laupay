# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Runtime connection for application queries. Supabase transaction pooler
# (port 6543, pgbouncer=true) keeps connection counts low on the server.
DATABASE_URL=postgresql://laupay:laupay@localhost:5432/laupay?schema=public
# Migration connection for the Prisma CLI (migrate deploy/dev, db push).
# Migrations take session-level advisory locks, so this MUST be the Supabase
# SESSION pooler (port 5432) or the direct connection — NOT the transaction
# pooler (port 6543), which breaks `prisma migrate deploy`.
DIRECT_URL=postgresql://laupay:laupay@localhost:5432/laupay?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# HMAC key for OTP hashes. Use a random secret of at least 32 characters in production.
OTP_PEPPER=replace-with-a-random-secret-of-at-least-32-characters

# --- CORS ---
ADMIN_WEB_ORIGIN=http://localhost:5173
# Explicit comma-separated browser origins. Set this in production.
ALLOWED_WEB_ORIGINS=http://localhost:5173

# --- Providers ---
# Production must use one of the real VTU providers below. Mock is reserved
# for automated tests and is rejected by the production boot guard.
PAYMENT_PROVIDER=paystack
VTU_PROVIDER=vtuagent

# --- Paystack TEST ---
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me

# --- Monnify SANDBOX ---
MONNIFY_API_KEY=MK_TEST_replace_me
MONNIFY_SECRET_KEY=replace_me
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_CONTRACT_CODE=replace_me
# BVN used to create sandbox reserved (virtual) accounts. Ignored in live mode,
# where each customer supplies their own BVN. Never persisted.
MONNIFY_TEST_BVN=22222222222

# --- VTUAgent ---
# VTUAgent has no separate public sandbox in its API documentation. Use only
# an account/key you intend to fund and set FULFILLMENT_MODE=live.
VTUAGENT_API_KEY=replace_me_server_only
VTUAGENT_BASE_URL=https://api.vtuagent.com/v1

# --- CheapDataHub ---
# CheapDataHub currently documents no public sandbox. Use only a funded
# reseller account and set FULFILLMENT_MODE=live.
CHEAPDATAHUB_API_KEY=replace_me_server_only
CHEAPDATAHUB_BASE_URL=https://www.cheapdatahub.ng/api/v1/resellers
# JSON from the provider's authoritative Plan IDs page/dashboard. Example:
# [{"network":"MTN","bundleId":12,"label":"1GB 30 Days","price":450,"validityDays":30}]
CHEAPDATAHUB_PLANS_JSON=[]
# Provider network IDs from the CheapDataHub account/docs, for example:
# {"MTN":1,"AIRTEL":2,"GLO":3,"9MOBILE":4}
CHEAPDATAHUB_NETWORK_IDS_JSON={}

# --- Legacy VTpass migration config (real provider; prefer VTUAgent/CheapDataHub) ---
VTPASS_API_KEY=replace_me
VTPASS_SECRET_KEY=replace_me
VTPASS_BASE_URL=https://sandbox.vtpass.com
# Legacy QA-only outcome; ignored by VTUAgent/CheapDataHub.
VTPASS_TEST_OUTCOME=provider

# Maximum time for a provider request (3s–30s; default 15s).
VTU_PROVIDER_TIMEOUT_MS=15000

# --- Brevo (Email OTP) ---
BREVO_API_KEY=xkeysib_replace_me
BREVO_SENDER_EMAIL=no-reply@laupay.app
BREVO_SENDER_NAME=LAUPAY
SUPPORT_EMAIL=support.laupay@gmail.com
CHARGEBACK_EMAIL=chargeback.laupay@gmail.com
# Comma-separated immutable user IDs with full Super Admin access, including
# staff-role management. Keep empty until the intended Super Admin is configured.
SUPER_ADMIN_IDS=
# Comma-separated allowlist for Super Admin access and account bootstrap.
# Each email receives its own ADMIN/ACTIVE account if one does not exist;
# a reset link is emailed only for a newly created account. Prefer immutable
# SUPER_ADMIN_IDS once the production user ID is known.
SUPER_ADMIN_EMAILS=
# Optional bootstrap for a regular initial admin, separate from SUPER_ADMIN_EMAILS.
# ADMIN_EMAIL and ADMIN_PASSWORD must both be set to create that account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=LAUPAY Admin
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
SUPABASE_STORAGE_BUCKET=profile-photos

# Base URL of this API, used to build OTP links emailed to users.
PUBLIC_API_BASE_URL=http://localhost:3000
# JSON bank directory must come from the configured payout provider's
# authoritative list. Leave [] to keep withdrawals disabled safely.
WITHDRAWAL_BANKS_JSON=[]

# --- ProofTrail integration ---
# Keep disabled until the ProofTrail partner, webhook URL, and synthetic E2E
# test are configured. These values are server-only and must never reach web apps.
PROOFTRAIL_ENABLED=false
PROOFTRAIL_BASE_URL=http://localhost:3001
PROOFTRAIL_API_KEY=replace_me_server_only
PROOFTRAIL_API_SECRET=replace_me_server_only
PROOFTRAIL_WEBHOOK_SECRET=replace_me_server_only
PROOFTRAIL_TIMEOUT_MS=10000
