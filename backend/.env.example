# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://laupay:laupay@localhost:5432/laupay?schema=public

# --- Auth ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
ADMIN_WEB_ORIGIN=http://localhost:5173

# --- Providers (mock mode needs no real keys) ---
PAYMENT_PROVIDER=mock
VTU_PROVIDER=mock

# Real provider keys (unused while PAYMENT_PROVIDER/VTU_PROVIDER=mock;
# fill these in only when switching to live providers)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_WEBHOOK_SECRET=
